[Unit]
Description=Pitwall periodic workspace snapshot (every 30 seconds)
Documentation=https://github.com/omgxai/pitwall
# The collector is read-only and persistence is hash-gated: unchanged ticks
# publish no database observation and no state-file content change. This keeps
# the panel responsive to session lifecycle changes without a resident daemon.

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
Persistent=false

[Install]
WantedBy=timers.target
