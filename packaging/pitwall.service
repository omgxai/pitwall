[Unit]
Description=Pitwall workspace snapshot (oneshot)
Documentation=https://github.com/omgxai/pitwall
# M2: persistence invocation path. Conservative by design: this is a
# oneshot unit, NOT a resident daemon. Pair with pitwall-snapshot.timer
# (every 30 seconds) or invoke manually via `pitwall snapshot`.
# Installed as a user unit by packaging/install.sh; still disabled unless the
# user explicitly enables the paired timer.
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/pitwall snapshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
